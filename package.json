{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@dnd-mapp/package-builder",
  "description": "Prepares the dist directory for npm publishing: writes a trimmed package.json, copies consumer files, and validates exports and bin paths.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "author": "D&D Mapp",
  "keywords": [
    "npm",
    "npm-package",
    "publishing",
    "build-tools",
    "cli",
    "typescript",
    "nodejs",
    "pnpm",
    "dnd-mapp"
  ],
  "homepage": "https://github.com/dnd-mapp/package-builder#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/package-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/package-builder.git"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "bin": {
    "prepare-dist": "./prepare-dist.js"
  },
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.js"
    },
    "./prepare-dist.schema.json": "./prepare-dist.schema.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && node src/prepare-dist.ts",
    "build": "tsdown",
    "test": "vitest --ui",
    "test-ci": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint-md": "markdownlint-cli2",
    "format": "prettier -w .",
    "format-check": "prettier -c ."
  },
  "engines": {
    "node": "^24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:commitlint",
    "@dnd-mapp/config-commitlint": "catalog:commitlint",
    "@dnd-mapp/config-markdown": "catalog:markdown",
    "@dnd-mapp/config-prettier": "catalog:prettier",
    "@dnd-mapp/config-typescript": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "lefthook": "catalog:commitlint",
    "markdownlint-cli2": "catalog:markdown",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:vitest",
    "vitest": "catalog:vitest"
  }
}
