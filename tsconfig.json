{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@dnd-mapp/config-typescript/node",
    "include": [
        "src",
        "testing",
        ".prettierrc.ts",
        "commitlint.config.ts",
        "eslint.config.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
    ],
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "verbatimModuleSyntax": true
    }
}
